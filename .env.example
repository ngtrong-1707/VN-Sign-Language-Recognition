# Environment configuration for VSL Platform
APP_NAME="VSL Vision"
DEBUG=false
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# SQLite or PostgreSQL URL
# SQLite default: sqlite+aiosqlite:///./vsl.db
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/vsl_db
DATABASE_URL="sqlite+aiosqlite:///./vsl.db"

# Inference parameters
PREDICTION_THRESHOLD=0.75
HISTORY_SMOOTHING_LEN=5
USE_ONNX=true
